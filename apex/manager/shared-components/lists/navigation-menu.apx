list navigation-menu (
    name: Navigation Menu
    entry nav-1 (
        label: Overview
        icon {
            imageIconCssClasses: fa-dashboard
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )
    entry nav-10 (
        label: Applications
        icon {
            imageIconCssClasses: fa-window
        }
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 10
            }
        }
    )
    entry nav-40 (
        label: Activity
        icon {
            imageIconCssClasses: fa-history
        }
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 40
            }
        }
    )
    entry nav-50 (
        label: Guide
        icon {
            imageIconCssClasses: fa-question-circle-o
        }
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 50
            }
        }
    )
)
