page 30 (
    name: Preview & confirmation
    alias: PREVIEW
    title: Preview & confirmation | APEX Theme Manager
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        authentication: required
        pageAccessProtection: argumentsMustHaveChecksum
    }
    advanced {
        reloadOnSubmit: always
    }

    region request-message (
        name: Request result
        type: staticContent
        layout {
            sequence: 5
            slot: body
            columnSpan: 12
            startNewRow: true
        }
        appearance {
            template: @/alert
            templateOptions: #DEFAULT#
    
        }
        source {
            htmlCode: ```html
    <p>&P30_NOTICE!HTML.</p>
    ```
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P30_NOTICE
        }
    
    
    )

    pageItem P30_NOTICE (
        type: hidden
    
        layout {
            sequence: 10
            region: @request-message
            slot: regionBody
    
        }
    
        security {
            sessionStateProtection: restricted
            encryptSessionState: true
        }
    
    )

    region confirmation (
        name: Review this operation
        type: staticContent
        layout {
            sequence: 10
            slot: body
            columnSpan: 12
            startNewRow: true
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
    
        }
        source {
            htmlCode: ```html
    <p>Review the target, selected count and expiry below. Applying captures a verified backup, checks the current fingerprint again, imports the proposed definition and independently verifies the result.</p><p class="apxtm-note">An import can commit or fail partially. A definition backup supports an explicit restore operation; a database transaction is not an application rollback.</p>
    ```
        }
    
    
    )

    region restore-warning (
        name: Full definition restore
        type: staticContent
        layout {
            sequence: 15
            slot: body
            columnSpan: 12
            startNewRow: true
        }
        appearance {
            template: @/alert
            templateOptions: #DEFAULT#
    
        }
        source {
            htmlCode: ```html
    <p>This operation restores the saved application definition. The snapshot and current application must have identical ACL assignment state. A difference is rejected for explicit manual review; this tool does not reset ACL assignments.</p><p>Saved report definitions may be reinstated. Database table data is not restored. Review the proposed archive and type the separate RESTORE confirmation phrase only when this is the intended result.</p>
    ```
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from apxtm_operations where operation_id=:P30_OPERATION_ID and operation_kind='RESTORE'
        }
    
    
    )

    pageItem P30_OPERATION_ID (
        type: hidden
    
        layout {
            sequence: 90
            region: @confirmation
            slot: regionBody
    
        }
    
        security {
            sessionStateProtection: restricted
            encryptSessionState: true
        }
    
    )

    pageItem P30_TOKEN (
        type: hidden
    
        layout {
            sequence: 100
            region: @confirmation
            slot: regionBody
    
        }
    
        security {
            sessionStateProtection: restricted
            encryptSessionState: true
        }
    
    )

    region operation (
        name: Operation preview
        type: classicReport
        layout {
            sequence: 20
            slot: body
            columnSpan: 12
            startNewRow: true
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
    
        }
        source {
            type: sqlQuery
            sqlQuery: ```sql
    select o.operation_id,o.application_id,a.application_name,o.operation_kind,o.selected_count,o.status,
     to_char(o.expires_at,'YYYY-MM-DD HH24:MI:SS TZH:TZM') expires_at,
     case o.operation_kind when 'RESTORE' then 'RESTORE ' else 'APPLY ' end||o.application_id confirmation_phrase,
     o.backup_snapshot_id,o.result_message
    from apxtm_operations o join apxtm_applications a on a.application_id=o.application_id
    where o.operation_id=:P30_OPERATION_ID and o.created_by=apxtm_engine.actor and apxtm_engine.allowed(o.application_id)=1
    ```
        }
        componentAppearance {
            templateType: theme
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: setPaginationSearchEngine
            partialPageRefresh: false
        }
        messages {
            whenNoDataFound: No records yet. Use the steps above to begin.
        }
        headerAndFooter {
            headerText: <p class="apxtm-table-hint">Scroll the table horizontally to view every column.</p>
        }
    
        column OPERATION_ID (
            type: plainText
            layout {
                sequence: 10
            }
            heading {
                heading: Operation
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column APPLICATION_ID (
            type: plainText
            layout {
                sequence: 20
            }
            heading {
                heading: App
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column APPLICATION_NAME (
            type: plainText
            layout {
                sequence: 30
            }
            heading {
                heading: Target
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column OPERATION_KIND (
            type: plainText
            layout {
                sequence: 40
            }
            heading {
                heading: Action
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column SELECTED_COUNT (
            type: plainText
            layout {
                sequence: 50
            }
            heading {
                heading: Selected properties
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column STATUS (
            type: plainText
            layout {
                sequence: 60
            }
            heading {
                heading: Status
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column EXPIRES_AT (
            type: plainText
            layout {
                sequence: 70
            }
            heading {
                heading: Expires
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column CONFIRMATION_PHRASE (
            type: plainText
            layout {
                sequence: 80
            }
            heading {
                heading: Type this phrase
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column BACKUP_SNAPSHOT_ID (
            type: plainText
            layout {
                sequence: 90
            }
            heading {
                heading: Backup snapshot
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column RESULT_MESSAGE (
            type: plainText
            layout {
                sequence: 100
            }
            heading {
                heading: Result
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
    )

    region selection (
        name: Previewed changes
        type: classicReport
        layout {
            sequence: 30
            slot: body
            columnSpan: 12
            startNewRow: true
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
    
        }
        source {
            type: sqlQuery
            sqlQuery: ```sql
    select d.page_id,d.component_type,d.component_name,d.property_name,d.current_value,d.baseline_value
    from apxtm_operations o join apxtm_differences d on d.comparison_id=o.comparison_id
    where o.operation_id=:P30_OPERATION_ID and o.created_by=apxtm_engine.actor and apxtm_engine.allowed(o.application_id)=1
    and d.difference_id in (select j.difference_id from json_table(o.selection,'$[*]' columns (difference_id number path '$.difference_id')) j)
    order by d.page_id,d.component_name,d.property_name
    ```
        }
        componentAppearance {
            templateType: theme
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: setPaginationSearchEngine
            partialPageRefresh: false
        }
        messages {
            whenNoDataFound: No records yet. Use the steps above to begin.
        }
        headerAndFooter {
            headerText: <p class="apxtm-table-hint">Scroll the table horizontally to view every column.</p>
        }
    
        column PAGE_ID (
            type: plainText
            layout {
                sequence: 10
            }
            heading {
                heading: Page
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column COMPONENT_TYPE (
            type: plainText
            layout {
                sequence: 20
            }
            heading {
                heading: Type
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column COMPONENT_NAME (
            type: plainText
            layout {
                sequence: 30
            }
            heading {
                heading: Component
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column PROPERTY_NAME (
            type: plainText
            layout {
                sequence: 40
            }
            heading {
                heading: Property
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column CURRENT_VALUE (
            type: plainText
            layout {
                sequence: 50
            }
            heading {
                heading: Current value
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column BASELINE_VALUE (
            type: plainText
            layout {
                sequence: 60
            }
            heading {
                heading: Proposed value
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
    )

    region artifacts (
        name: Immutable definition fingerprints
        type: classicReport
        layout {
            sequence: 40
            slot: body
            columnSpan: 12
            startNewRow: true
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
    
        }
        source {
            type: sqlQuery
            sqlQuery: ```sql
    select 'Expected current definition' definition,a.artifact_id,a.source_hash,a.archive_hash,cast(null as varchar2(4000)) download
    from apxtm_operations o join apxtm_artifacts a on a.artifact_id=o.expected_artifact_id
    where o.operation_id=:P30_OPERATION_ID and o.created_by=apxtm_engine.actor and apxtm_engine.allowed(o.application_id)=1
    union all
    select 'Proposed definition',a.artifact_id,a.source_hash,a.archive_hash,
     '<a href="'||apex_escape.html_attribute(apex_page.get_url(p_page=>61,p_items=>'P61_OPERATION_ID',p_values=>o.operation_id))||'">Download proposed ZIP</a>'
    from apxtm_operations o join apxtm_artifacts a on a.artifact_id=o.proposed_artifact_id
    where o.operation_id=:P30_OPERATION_ID and o.created_by=apxtm_engine.actor and apxtm_engine.allowed(o.application_id)=1
    ```
        }
        componentAppearance {
            templateType: theme
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: setPaginationSearchEngine
            partialPageRefresh: false
        }
        messages {
            whenNoDataFound: No records yet. Use the steps above to begin.
        }
        headerAndFooter {
            headerText: <p class="apxtm-table-hint">Scroll the table horizontally to view every column.</p>
        }
    
        column DEFINITION (
            type: plainText
            layout {
                sequence: 10
            }
            heading {
                heading: Definition
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column ARTIFACT_ID (
            type: plainText
            layout {
                sequence: 20
            }
            heading {
                heading: Artifact
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column SOURCE_HASH (
            type: plainText
            layout {
                sequence: 30
            }
            heading {
                heading: Source SHA-256
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column ARCHIVE_HASH (
            type: plainText
            layout {
                sequence: 40
            }
            heading {
                heading: ZIP SHA-256
            }
            security {
                escapeSpecialChars: true
            }
            sorting {
                sortable: false
            }
        )
        column DOWNLOAD (
            type: plainText
            layout {
                sequence: 50
            }
            heading {
                heading: Inspect
            }
            security {
                escapeSpecialChars: false
            }
            sorting {
                sortable: false
            }
        )
    )

    pageItem P30_CONFIRMATION (
        type: textField
        label {
            label: Confirmation phrase
        }
        layout {
            sequence: 10
            region: @confirmation
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional-floating
            width: 60
        }
        validation {
            valueRequired: false
            maxLength: 100
        }
        security {
            sessionStateProtection: unrestricted
            encryptSessionState: true
        }
        help {
            inlineHelpText: Enter APPLY followed by the target application ID for recovery, or RESTORE followed by the ID for a definition restore.
        }
    
    )

    button apply (
        buttonName: APPLY
        label: Apply reviewed operation
        layout {
            sequence: 10
            region: @confirmation
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
        }
        behavior {
            action: submitPage
            showProcessing: true
        }
        serverSideCondition {
            type: rowsReturned
            sqlQuery: select 1 from apxtm_operations where operation_id=:P30_OPERATION_ID and status='PREVIEW' and expires_at>systimestamp and apxtm_engine.allowed(application_id,case operation_kind when 'RESTORE' then 'RESTORE' else 'RECOVER' end)=1
        }
    )

    button back (
        buttonName: BACK
        label: Back to applications
        layout {
            sequence: 20
            region: @confirmation
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: false
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 10
            }
        }
    
    )

    process authorize-operation (
        name: Authorize preview
        type: executeCode
        advanced {
            executionMappingIdentifier: 217572163725189
        }
        execution {
            sequence: 1
            point: beforeHeader
        }
        source {
            plsqlCode: ```plsql
    declare app_id number; owner_actor varchar2(300); begin
     select application_id,created_by into app_id,owner_actor from apxtm_operations where operation_id=:P30_OPERATION_ID;
     if owner_actor<>apxtm_engine.actor then raise_application_error(-20040,'This preview belongs to another actor.'); end if;
     apxtm_engine.assert_access(app_id,'READ');
    end;
    ```
        }
    
    )

    process apply (
        name: Apply reviewed operation
        type: executeCode
        advanced {
            executionMappingIdentifier: 164811444815870
        }
        execution {
            sequence: 10
            point: processing
        }
        source {
            plsqlCode: ```plsql
    declare request_error varchar2(4000); request_error_code number; begin
     apex_util.set_session_state('P30_NOTICE',null);
     declare kind varchar2(20); app_id number; token varchar2(4000):=:P30_TOKEN; begin
     if owa_util.get_cgi_env('REQUEST_METHOD')<>'POST' then raise_application_error(-20040,'Apply requires a page submission.'); end if;
     select operation_kind,application_id into kind,app_id from apxtm_operations where operation_id=:P30_OPERATION_ID;
     apxtm_engine.assert_access(app_id,case when kind='RESTORE' then 'RESTORE' else 'RECOVER' end);
     apxtm_engine.apply(:P30_OPERATION_ID,token,:P30_CONFIRMATION);
     apex_util.set_session_state('P30_TOKEN',null);
     apex_util.set_session_state('P30_CONFIRMATION',null);
    end;
     apex_util.set_session_state('P30_NOTICE','Operation completed. Review its verified status and backup snapshot below.');
     apex_util.redirect_url(apex_page.get_url(p_page=>30));
    exception
     when apex_application.e_stop_apex_engine then raise;
     when others then
      request_error_code:=sqlcode;
      request_error:=case when request_error_code between -20999 and -20000 then regexp_replace(sqlerrm,'^ORA-[0-9]+: ','') else 'The request failed. Review Activity or contact the workspace administrator.' end;
      apex_util.set_session_state('P30_NOTICE','Request failed ('||request_error_code||'): '||substr(request_error,1,3000));
      apex_util.redirect_url(apex_page.get_url(p_page=>30));
    end;
    ```
        }
        serverSideCondition {
            whenButtonPressed: @apply
        }
    
    )
)
